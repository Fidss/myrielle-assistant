{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "templates/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/chat",
      "dest": "app.py",
      "methods": ["POST"]
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
